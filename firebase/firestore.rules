rules_version = '2';

// 채팅 데이터 보안 규칙.
// Firebase 콘솔 > Firestore > 규칙에 붙여 넣거나, firebase deploy --only firestore:rules 로 배포합니다.
//
// 핵심 원칙: 방에 참여한 두 사람만 그 방과 메시지를 읽고 쓸 수 있습니다.
// 규칙이 없으면(테스트 모드) 누구나 남의 대화를 읽을 수 있으므로 반드시 적용해야 합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필: 이름은 누구나 볼 수 있어야 채팅 상대 이름을 표시할 수 있습니다.
    // 쓰기는 본인만 가능합니다(푸시 토큰이 여기 저장되므로 남이 못 건드리게 합니다).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /chatRooms/{roomId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participantIds;

      // 방을 새로 만들 때는 본인이 참여자에 포함되어 있어야 합니다.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participantIds;

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participantIds;

      // 대화 기록은 삭제하지 않습니다. 필요하면 정책을 정해 따로 여세요.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participantIds;

        // 보낸 사람을 위조할 수 없도록 senderId 가 본인인지 확인합니다.
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participantIds
                      && request.resource.data.senderId == request.auth.uid;

        allow update, delete: if false;
      }
    }
  }
}
